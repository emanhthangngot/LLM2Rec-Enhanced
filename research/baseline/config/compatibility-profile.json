    {
      "id": "iem",
      "script": "kaggle/iem_pipeline.py",
      "kernel": "trixuanle/llm2rec-budgeted-iem-disk-retry",
      "input": "csft/checkpoint-1000",
      "outputs": ["checkpoint-500", "checkpoint-1000"],
      "config": {
        "mntp_steps": 1000,
        "mntp_per_device_batch_size": 8,
        "mntp_gradient_accumulation_steps": 4,
