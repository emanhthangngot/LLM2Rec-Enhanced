        "mntp_max_seq_length": 512,
        "mntp_mlm_probability": 0.2,
        "mntp_mask_token_type": "blank",
        "mntp_line_by_line": true,
        "mntp_gradient_checkpointing": true,
        "mntp_eval_steps": 100,
        "simcse_steps": 1000,
        "simcse_per_device_batch_size": 32,
        "simcse_official_batch_size": 256,
        "simcse_gradient_accumulation_steps": 1,
        "simcse_max_seq_length": 512,
        "simcse_num_train_epochs": 5,
        "simcse_max_grad_norm": 1.0,
        "learning_rate": 0.0002,
        "warmup_steps": 300,
        "simcse_dropout": 0.2,
        "loss_scale": 10.0,
        "pooling_mode": "mean",
        "seed": 42,
        "bidirectional": true,
        "save_steps": [500, 1000],
        "save_only_model": true,
        "tokenizer_override": true
      }
    },
    {
      "id": "evaluation",
      "script": "kaggle/evaluate_games.py",
      "kernel": "trixuanle/llm2rec-budgeted-games-sasrec-evaluation",
      "kernel_version": 8,
      "input": "trixuanle/llm2rec-games-5core",
      "config": {
        "dataset": "Games_5core",
        "item_prompt_type": "title",
        "bidirectional": 1,
        "extraction_batch_size": 16,
        "checkpoints": [500, 1000],
        "sasrec_model": "SASRec",
        "learning_rate": 0.001,
        "weight_decay": 0.0001,
        "dropout": 0.3,
        "loss_type": "ce",
        "seeds": [2024, 2025, 2026],
        "full_catalog_scoring": true
      }
    },
    {
      "id": "audit",
      "script": "kaggle/audit_games.py",
      "kernel": "trixuanle/llm2rec-games-raw-rank-and-bidirectional-audit",
      "kernel_version": 5,
      "input": "evaluation + IEM + Games_5core",
      "outputs": [
        "llm2rec_audit_artifact.json",
        "raw_ranks_step{500,1000}_seed{2024,2025,2026}.npz"
      ],
      "config": {
        "raw_rank_tolerance": 1e-8,
        "required_users": 15323,
        "required_top_k": 20,
        "require_finite_values": true
      }
    }
  ],
